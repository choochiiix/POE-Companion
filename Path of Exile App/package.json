{
  "name": "poe1-crafting-project",
  "version": "0.3.0",
  "private": true,
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node crafting-ui/server.mjs",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:dist": "electron-builder --win nsis --x64",
    "tags:build": "node scripts/build-tags.mjs",
    "data:build": "node --experimental-strip-types scripts/build-data.mjs",
    "test": "node --experimental-strip-types --test crafting-engine/test/*.test.ts crafting-data/test/*.test.ts crafting-ui/test/*.test.mjs calculation-engine/test/*.test.ts",
    "test:calculations": "node --experimental-strip-types --test calculation-engine/test/*.test.ts",
    "calculations:compare": "node --experimental-strip-types calculation-engine/reference/compare.ts",
    "calculations:trial": "node --experimental-strip-types calculation-engine/trial/run.ts",
    "calculations:corpus": "node --experimental-strip-types calculation-engine/corpus/run.ts",
    "calculations:data": "node scripts/build-calculation-ui.mjs",
    "typecheck": "tsc --project crafting-engine/tsconfig.json && tsc --project crafting-data/tsconfig.json && tsc --project calculation-engine/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/node": "^22.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.exilecompanion.desktop",
    "productName": "Exile Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "crafting-ui/**",
          "renderer/dist/**",
          "glossary/master.json",
          "catalog-data.json",
          "unique-art.json",
          "skills-data.json",
          "tag-data.json",
          "tooltip-data.json",
          "buff-data.json",
          "data-sources/pob-tree-3_29/**",
          "crafting-data/repoe-poe1.json",
          "crafting-engine/**",
          "calculation-engine/src/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Exile-Companion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Exile Companion"
    }
  }
}
